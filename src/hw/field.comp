#version 450
// field: 2D/3D-шейдеры на GPU. data[0..7] -- параметры, data[16..] -- RGB.
//
// Режимы:
//   0 plasma
//   1 sun & grid -- по мотивам Jan Mróz (jaszunio15), Shader License CC BY 3.0
//   2 fractal pyramid -- по мотивам Shadertoy
//   3 sine lattice    -- по мотивам Shadertoy
//   4 star tunnel     -- по мотивам Shadertoy
//
// Mandelbrot и Julia удалены по просьбе.
//
// Экран терминала: символ 8x16, поэтому по Y берём два пикселя на клетку.
layout(local_size_x = 64) in;
layout(binding = 0) buffer B { uint data[]; } b;

float g_time;
vec2 g_res;

vec3 palette(float t) {
    return 0.5 + 0.5 * cos(6.28318 * (vec3(0.0, 0.33, 0.67) + t));
}

vec2 rot2(vec2 p, float a) {
    float c = cos(a);
    float s = sin(a);
    return vec2(p.x * c - p.y * s, p.x * s + p.y * c);
}

// ---------------------------------------------------------------- sun & grid
float sun_val(vec2 uv, float battery) {
    float val = smoothstep(0.3, 0.29, length(uv));
    float bloom = smoothstep(0.7, 0.0, length(uv));
    float cut = 3.0 * sin((uv.y + g_time * 0.2 * (battery + 0.02)) * 100.0)
        + clamp(uv.y * 14.0 + 1.0, -6.0, 6.0);
    cut = clamp(cut, 0.0, 1.0);
    return clamp(val * cut, 0.0, 1.0) + bloom * 0.6;
}

float grid_val(vec2 uv, float battery) {
    vec2 size = vec2(uv.y, uv.y * uv.y * 0.2) * 0.01;
    uv += vec2(0.0, g_time * 4.0 * (battery + 0.05));
    uv = abs(fract(uv) - 0.5);
    vec2 lines = smoothstep(size, vec2(0.0), uv);
    lines += smoothstep(size * 5.0, vec2(0.0), uv) * 0.4 * battery;
    return clamp(lines.x + lines.y, 0.0, 3.0);
}

float dot2v(vec2 v) { return dot(v, v); }

float sd_trapezoid(vec2 p, float r1, float r2, float he) {
    vec2 k1 = vec2(r2, he);
    vec2 k2 = vec2(r2 - r1, 2.0 * he);
    p.x = abs(p.x);
    vec2 ca = vec2(p.x - min(p.x, (p.y < 0.0) ? r1 : r2), abs(p.y) - he);
    vec2 cb = p - k1 + k2 * clamp(dot(k1 - p, k2) / dot2v(k2), 0.0, 1.0);
    float s = (cb.x < 0.0 && ca.y < 0.0) ? -1.0 : 1.0;
    return s * sqrt(min(dot2v(ca), dot2v(cb)));
}

float sd_line(vec2 p, vec2 a, vec2 b) {
    vec2 pa = p - a;
    vec2 ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h);
}

float sd_box(vec2 p, vec2 sz) {
    vec2 d = abs(p) - sz;
    return length(max(d, vec2(0.0))) + min(max(d.x, d.y), 0.0);
}

float op_smooth_union(float d1, float d2, float k) {
    float h = clamp(0.5 + 0.5 * (d2 - d1) / k, 0.0, 1.0);
    return mix(d2, d1, h) - k * h * (1.0 - h);
}

float sd_cloud(vec2 p, vec2 a1, vec2 b1, vec2 a2, vec2 b2, float w) {
    float line1 = sd_line(p, a1, b1);
    float line2 = sd_line(p, a2, b2);
    vec2 ww = vec2(w * 1.5, 0.0);
    vec2 left = max(a1 + ww, a2 + ww);
    vec2 right = min(b1 - ww, b2 - ww);
    vec2 box_center = (left + right) * 0.5;
    float box_h = abs(a2.y - a1.y) * 0.5;
    float box_val = sd_box(p - box_center, vec2(0.04, box_h)) + w;
    float uni1 = op_smooth_union(line1, box_val, 0.05);
    float uni2 = op_smooth_union(line2, box_val, 0.05);
    return min(uni1, uni2);
}

vec3 shader_sun(vec2 fc) {
    vec2 uv = (2.0 * fc - g_res) / g_res.y;
    float battery = 1.0;
    float fog = smoothstep(0.1, -0.02, abs(uv.y + 0.2));
    vec3 col = vec3(0.0, 0.1, 0.2);
    if (uv.y < -0.2) {
        uv.y = 3.0 / (abs(uv.y + 0.2) + 0.05);
        uv.x *= uv.y;
        float gv = grid_val(uv, battery);
        col = mix(col, vec3(1.0, 0.5, 1.0), gv);
    } else {
        float fuji_d = min(uv.y * 4.5 - 0.5, 1.0);
        uv.y -= battery * 1.1 - 0.51;
        vec2 sun_uv = uv + vec2(0.75, 0.2);
        col = vec3(1.0, 0.2, 1.0);
        float sun_value = sun_val(sun_uv, battery);
        col = mix(col, vec3(1.0, 0.4, 0.1), sun_uv.y * 2.0 + 0.2);
        col = mix(vec3(0.0), col, sun_value);

        float fuji = sd_trapezoid(uv + vec2(-0.75, 0.5), 1.75 + pow(uv.y * uv.y, 2.1), 0.2, 0.5);
        float wave = uv.y + sin(uv.x * 20.0 + g_time * 2.0) * 0.05 + 0.2;
        float wave_width = smoothstep(0.0, 0.01, wave);

        col = mix(col, mix(vec3(0.0, 0.0, 0.25), vec3(1.0, 0.0, 0.5), fuji_d), step(fuji, 0.0));
        col = mix(col, vec3(1.0, 0.5, 1.0), wave_width * step(fuji, 0.0));
        col = mix(col, vec3(1.0, 0.5, 1.0), 1.0 - smoothstep(0.0, 0.01, abs(fuji)));
        col += mix(col, mix(vec3(1.0, 0.12, 0.8), vec3(0.0, 0.0, 0.2),
            clamp(uv.y * 3.5 + 3.0, 0.0, 1.0)), step(0.0, fuji));

        vec2 cloud_uv = uv;
        cloud_uv.x = mod(cloud_uv.x + g_time * 0.1, 4.0) - 2.0;
        float ct = g_time * 0.5;
        float cy = -0.5;
        float cloud1 = sd_cloud(cloud_uv,
            vec2(0.1 + sin(ct + 140.5) * 0.1, cy),
            vec2(1.05 + cos(ct * 0.9 - 36.56) * 0.1, cy),
            vec2(0.2 + cos(ct * 0.867 + 387.165) * 0.1, 0.25 + cy),
            vec2(0.5 + cos(ct * 0.9675 - 15.162) * 0.09, 0.25 + cy), 0.075);
        cy = -0.6;
        float cloud2 = sd_cloud(cloud_uv,
            vec2(-0.9 + cos(ct * 1.02 + 541.75) * 0.1, cy),
            vec2(-0.5 + sin(ct * 0.9 - 316.56) * 0.1, cy),
            vec2(-1.5 + cos(ct * 0.867 + 37.165) * 0.1, 0.25 + cy),
            vec2(-0.6 + sin(ct * 0.9675 + 665.162) * 0.09, 0.25 + cy), 0.075);
        float cloud = min(cloud1, cloud2);
        col = mix(col, vec3(0.0, 0.0, 0.2), 1.0 - smoothstep(0.075 - 0.0001, 0.075, cloud));
        col += vec3(1.0) * (1.0 - smoothstep(0.0, 0.01, abs(cloud - 0.075)));
    }
    col += fog * fog * fog;
    col = mix(vec3(col.r) * 0.5, col, battery * 0.7);
    return col;
}

// ------------------------------------------------------------ fractal pyramid
vec3 palette_pyramid(float d) {
    return mix(vec3(0.2, 0.7, 0.9), vec3(1.0, 0.0, 1.0), d);
}

float map_pyramid(vec3 p) {
    for (int i = 0; i < 8; ++i) {
        float t = g_time * 0.2;
        p.xz = rot2(p.xz, t);
        p.xy = rot2(p.xy, t * 1.89);
        p.xz = abs(p.xz);
        p.xz -= 0.5;
    }
    return dot(sign(p), p) / 5.0;
}

vec4 rm_pyramid(vec3 ro, vec3 rd) {
    float t = 0.0;
    vec3 col = vec3(0.0);
    float d = 1.0;
    for (float i = 0.0; i < 64.0; i++) {
        vec3 p = ro + rd * t;
        d = map_pyramid(p) * 0.5;
        if (d < 0.02 || d > 100.0) {
            break;
        }
        col += palette_pyramid(length(p) * 0.1) / (400.0 * d);
        t += d;
    }
    return vec4(col, 1.0 / (d * 100.0));
}

vec3 shader_pyramid(vec2 fc) {
    vec2 uv = (fc - g_res * 0.5) / g_res.x;
    vec3 ro = vec3(0.0, 0.0, -50.0);
    ro.xz = rot2(ro.xz, g_time);
    vec3 cf = normalize(-ro);
    vec3 cs = normalize(cross(cf, vec3(0.0, 1.0, 0.0)));
    vec3 cu = normalize(cross(cf, cs));
    vec3 uuv = ro + cf * 3.0 + uv.x * cs + uv.y * cu;
    vec3 rd = normalize(uuv - ro);
    return rm_pyramid(ro, rd).rgb;
}

// -------------------------------------------------------------- sine lattice
float map_lattice(vec3 p) {
    vec3 n = vec3(0.0, 1.0, 0.0);
    float k1 = 1.9;
    float k2 = (sin(p.x * k1) + sin(p.z * k1)) * 0.8;
    float k3 = (sin(p.y * k1) + sin(p.z * k1)) * 0.8;
    float w1 = 4.0 - dot(abs(p), normalize(n)) + k2;
    float w2 = 4.0 - dot(abs(p), normalize(n.yzx)) + k3;
    float s1 = length(mod(p.xy + vec2(sin((p.z + p.x) * 2.0) * 0.3,
        cos((p.z + p.x) * 1.0) * 0.5), 2.0) - 1.0) - 0.2;
    float s2 = length(mod(0.5 + p.yz + vec2(sin((p.z + p.x) * 2.0) * 0.3,
        cos((p.z + p.x) * 1.0) * 0.3), 2.0) - 1.0) - 0.2;
    return min(w1, min(w2, min(s1, s2)));
}

vec3 shader_lattice(vec2 fc) {
    vec2 uv = (fc / g_res) * 2.0 - 1.0;
    uv.x *= g_res.x / g_res.y;
    vec3 dir = normalize(vec3(uv, 1.0));
    dir.xz = rot2(dir.xz, g_time * 0.23);
    dir = dir.yzx;
    dir.xz = rot2(dir.xz, g_time * 0.2);
    dir = dir.yzx;
    vec3 pos = vec3(0.0, 0.0, g_time);
    float t = 0.0;
    float tt = 0.0;
    for (int i = 0; i < 100; i++) {
        tt = map_lattice(pos + dir * t);
        if (tt < 0.001) {
            break;
        }
        t += tt * 0.45;
    }
    vec3 ip = pos + dir * t;
    vec3 col = sqrt(vec3(t * 0.1));
    return 0.05 * t + abs(dir) * col + max(0.0, map_lattice(ip - 0.1) - tt);
}

// --------------------------------------------------------------- star tunnel
#define NUM_LAYERS 10.0

mat2 RotS(float a) {
    float c = cos(a);
    float s = sin(a);
    return mat2(c, -s, s, c);
}

float StarS(vec2 uv, float flare) {
    float col = 0.0;
    float d = length(uv);
    float m = 0.02 / d;
    float rays = max(0.0, 1.0 - abs(uv.x * uv.y * 1000.0));
    m += rays * flare;
    uv *= RotS(3.1415 / 4.0);
    rays = max(0.0, 1.0 - abs(uv.x * uv.y * 1000.0));
    m += rays * 0.3 * flare;
    m *= smoothstep(1.0, 0.2, d);
    return m;
}

float Hash21(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

vec3 StarLayerS(vec2 uv) {
    vec3 col = vec3(0.0);
    vec2 gv = fract(uv) - 0.5;
    vec2 id = floor(uv);
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec2 offs = vec2(x, y);
            float n = Hash21(id + offs);
            float size = fract(n * 345.32);
            vec2 p = vec2(n, fract(n * 34.0));
            float star = StarS(gv - offs - p + 0.5, smoothstep(0.8, 1.0, size) * 0.6);
            float hue = fract(n * 2345.2 + dot(uv / 420.0, vec2(0.25, 0.0)));
            vec3 hue_shift = hue * vec3(0.2, 0.3, 0.9) * 123.2;
            vec3 color = sin(hue_shift) * 0.5 + 0.5;
            color *= vec3(1.0, 0.25, 1.0 + size);
            star *= sin(g_time * 3.0 + n * 6.2831) * 0.4 + 1.0;
            col += star * size * color;
        }
    }
    return col;
}

vec2 NS(float angle) {
    return vec2(sin(angle), cos(angle));
}

vec3 shader_stars(vec2 fc) {
    vec2 uv = (fc - 0.5 * g_res) / g_res.y;
    float t = g_time * 0.01;
    uv.x = abs(uv.x);
    uv.y += tan((5.0 / 6.0) * 3.1415) * 0.5;
    vec2 n = NS((5.0 / 6.0) * 3.1415);
    float d = dot(uv - vec2(0.5, 0.0), n);
    uv -= n * max(0.0, d) * 2.0;
    n = NS((2.0 / 3.0) * 3.1415);
    uv.x += 1.5 / 1.25;
    for (int i = 0; i < 5; i++) {
        uv *= 1.25;
        uv.x -= 1.5;
        uv.x = abs(uv.x);
        uv.x -= 0.5;
        uv -= n * min(0.0, dot(uv, n)) * 2.0;
    }
    uv *= RotS(t);
    vec3 col = vec3(0.0);
    for (float i = 0.0; i < 1.0; i += 1.0 / NUM_LAYERS) {
        float depth = fract(i + t);
        float scale = mix(20.0, 0.5, depth);
        float fade = depth * smoothstep(1.0, 0.9, depth);
        col += StarLayerS(uv * scale + i * 453.2) * fade;
    }
    return col;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint w = b.data[0];
    uint h = b.data[1];
    if (w == 0u || h == 0u || i >= w * h) {
        return;
    }
    uint mode = b.data[2];
    float t = float(b.data[3]) * 0.001;
    float zoom = uintBitsToFloat(b.data[4]);
    float cx = uintBitsToFloat(b.data[5]);
    float cy = uintBitsToFloat(b.data[6]);
    uint x = i % w;
    uint y = i / w;
    // В терминале Y растёт вниз, в шейдерах Shadertoy -- вверх. Переворачиваем.
    vec2 fc = vec2(float(x), float((h - 1u - y) * 2u));
    vec2 res = vec2(float(w), float(h) * 2.0);
    g_time = t;
    g_res = res;
    vec2 uv = fc / res - 0.5;
    vec2 uvz = uv / zoom + vec2(cx, cy);
    // Общий зум/панорама для шейдеров, которые рисуют по координатам экрана.
    vec2 fcz = (fc - res * 0.5) / zoom + res * 0.5 + vec2(cx, cy) * res.y;
    vec3 col = vec3(0.0);

    // Режимы: 0 plasma, 1 sun & grid, 2 fractal pyramid, 3 sine lattice, 4 stars.
    // Mandelbrot и Julia удалены.
    if (mode == 0u) {
        float a = uvz.x * 8.0 + t * 0.7;
        float d = uvz.y * 8.0 - t * 0.9;
        float v = sin(a) + sin(d * 1.3) + sin((a + d) * 0.7)
            + sin(sqrt(a * a + d * d) * 1.7 - t);
        col = palette(v * 0.12 + t * 0.05);
    } else if (mode == 1u) {
        col = shader_sun(fcz);
    } else if (mode == 2u) {
        col = shader_pyramid(fcz);
    } else if (mode == 3u) {
        col = shader_lattice(fcz);
    } else {
        col = shader_stars(fcz);
    }

    uint r = uint(clamp(col.r, 0.0, 1.0) * 255.0);
    uint g = uint(clamp(col.g, 0.0, 1.0) * 255.0);
    uint bl = uint(clamp(col.b, 0.0, 1.0) * 255.0);
    b.data[16u + i] = (r << 16) | (g << 8) | bl;
}
